Cell[BoxData[RowBox[{"MatrixPlot", "[", RowBox[
                {RowBox[{"Table", "[", RowBox[{RowBox[{"With", "[", RowBox[
                        {RowBox[{"{", RowBox[{"value", "=", RowBox[
                          {"EvaluateRecursor", "[", RowBox[{"p", ",", "n", 
                          ",", RowBox[{"\"MaxSteps\"", "\[Rule]", "5000"}]}], 
                          "]"}]}], "}"}], ",", RowBox[{"If", "[", RowBox[
                          {RowBox[{"IntegerQ", "[", "value", "]"}], ",", 
                          RowBox[{"Log", "[", RowBox[{"1", "+", "value"}], 
                          "]"}], ",", "Indeterminate"}], "]"}]}], "]"}], ",", 
                     RowBox[{"{", RowBox[{"n", ",", "0", ",", "6"}], "}"}], 
                     ",", RowBox[{"{", RowBox[{"p", ",", "mutants"}], 
                       "}"}]}], "]"}], ",", RowBox[{"FrameTicks", "\[Rule]", 
                   RowBox[{"{", RowBox[{RowBox[{"Table", "[", RowBox[
                          {RowBox[{"{", RowBox[{RowBox[{"n", "+", "1"}], ",", 
                          "n"}], "}"}], ",", RowBox[{"{", RowBox[{"n", ",", 
                          "0", ",", "6"}], "}"}]}], "]"}], ",", RowBox[
                        {"Table", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[
                          {"k", "+", "1"}], ",", "k"}], "}"}], ",", RowBox[
                          {"{", RowBox[{"k", ",", "0", ",", "20", ",", "4"}], 
                          "}"}]}], "]"}]}], "}"}]}], ",", RowBox[
                  {"FrameLabel", "\[Rule]", RowBox[{"{", RowBox[{"\"Input\"", 
                       ",", "\"Mutation\""}], "}"}]}], ",", RowBox[
                  {"PlotLegends", "\[Rule]", "Automatic"}]}], "]"}]], 
            "Input", ExpressionUUID -> 
             "ad8dd2d4-a866-4e52-ba20-dabb33a83bd2"],

