-> {0, {1, 1, 2, 4, 9, 21, 51, 127, 323, 835, 2188, 5798, 15511, 41835, \
113634, 310572, 853467, 2356779, 6536382, 18199284, 50852019, 142547559, \
400763223, 1129760415, 3192727797, 9043402501, 25669818476, 73007772802, \
208023278209, 593742784829, 1697385471211}},\n\t\"A005258\" -> {0, {1, 3, 19, \
147, 1251, 11253, 104959, 1004307, 9793891, 96918753, 970336269, 9807518757, \
99912156111, 1024622952993, 10567623342519, 109527728400147, \
1140076177397091, 11911997404064793, 124879633548031009, 1313106114867738897, \
13844511065506477501}},\n\t\"A001181\" -> {0, {1, 1, 2, 6, 22, 92, 422, 2074, \
10754, 58202, 326240, 1882960, 11140560, 67329992, 414499438, 2593341586, \
16458756586, 105791986682, 687782586844, 4517543071924, 29949238543316, \
200234184620736, 1349097425104912, 9154276618636016, \
62522506583844272}}|>;\n\ntwelve = <|\"A000040\" -> \"Prime numbers\", \
\"A000108\" -> \"Catalan numbers\", \"A000166\" -> \"Derangements\", \
\"A000120\" -> \"Binary weight\",\n\t\"A000123\" -> \"Binary partitions\", \
\"A018252\" -> \"Nonprime numbers\", \"A000272\" -> \"Labeled trees\", \
\"A000005\" -> \"Number of divisors\",\n\t\"A002808\" -> \"Composite \
numbers\", \"A001006\" -> \"Motzkin numbers\", \"A005258\" -> \"Ap\[EAcute]ry \
numbers\", \"A001181\" -> \"Baxter permutations\"|>;\n\noeis[id_String] := \
With[{offset = recorded[id][[1]], terms = recorded[id][[2]]}, \
Transpose[{offset + Range[0, Length[terms] - 1], terms}]]\n\ngiven = \
20;\n\nlimits = {\"MaxSteps\" -> 2000, \"TimeLimit\" -> 1};\n\n(* guided \
variation: each change is worked out backwards from the terms \
*)\nguided[id_String, generations_Integer : 30, seed_Integer : 1] := \
EvolveRecursor[Take[oeis[id], given], Method -> \"Guided\", \
\"MaxGenerations\" -> generations,\n\t\"StopOnSolve\" -> False, \
\"RandomSeed\" -> seed, Sequence @@ limits]\n\n(* the same search with larger \
pieces in its library *)\nwider[id_String, cost_Integer] := \
EvolveRecursor[Take[oeis[id], given], Method -> \"Guided\", \"LibraryCost\" \
-> cost, \"StopOnSolve\" -> False, \"RandomSeed\" -> 1, Sequence @@ \
limits]\n\n(* how many of the recorded terms after the ones given a program \
reproduces *)\nlater[id_String, program_] := With[{rest = Drop[oeis[id], \
given]}, Row[{Count[rest, {n_, term_} /; value[program, n] === term], \" of \
\", Length[rest]}]]\n\nrandom[id_String, seed_Integer : 1] := \
EvolveRecursor[Take[oeis[id], given], \"StopOnSolve\" -> False, \
\"RandomSeed\" -> seed, Sequence @@ limits]\n\n(* every program of a search \
as a dot, and the best so far as a line *)\nevolutionPlot[id_String, \
result_Association, size_ : 230] := Show[\n\tListPlot[{#Generation, #Score} & \
/@ Select[result[\"Genealogy\"], #Size <= 60 &], PlotStyle -> \
Directive[GrayLevel[0.55], Opacity[0.35], \
PointSize[If[Length[result[\"FitnessHistory\"]] > 60, 0.006, \
0.012]]]],\n\tListStepPlot[result[\"FitnessHistory\"], DataRange -> {0, \
Length[result[\"FitnessHistory\"]] - 1}, PlotStyle -> Directive[ColorData[97, \
2], Thick]],\n\tPlotRange -> {{-0.5, Length[result[\"FitnessHistory\"]] - \
0.5}, {-0.5, given + 0.7}}, PlotLabel -> twelve[id], Frame -> True, Axes -> \
False,\n\tFrameLabel -> {\"Generation\", \"Terms reproduced\"}, ImageSize -> \
size]\n\nvalue[program_, n_] := EvaluateRecursor[program, n, \"MaxSteps\" -> \
2000000, \"TimeLimit\" -> 10]\n\n(* which recorded terms a program \
reproduces: the terms given, then the ones after them \
*)\ntermStrip[id_String, program_, shown_ : given] := \
ArrayPlot[{Boole[value[program, First[#]] === Last[#]] & /@ oeis[id]}, \
ColorRules -> {1 -> RGBColor[0.2, 0.65, 0.4], 0 -> GrayLevel[0.85]},\n\tMesh \
-> True, MeshStyle -> White, Frame -> False, ImageSize -> 330, Epilog -> \
{Black, Thick, Line[{{shown, 0}, {shown, 1}}]}]\n\nwl[id_String, program_] := \
TranslateRecursor[program, \"TestInputs\" -> Take[oeis[id], given][[All, \
1]]]\n\n(* the programs at which a search first reproduced more terms \
*)\nbreakthroughs[result_Association] := Module[{best = \
-1},\n\tSelect[SortBy[result[\"Genealogy\"], {#Generation &, -#Score &}], \
If[#Score > best, best = #Score; True, False] &]\n]", "Code"]}, Closed]], 
