2, 2, 3, 2, 3, 3, 4, 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 5, 1, 2, 2, \
3, 2, 3, 3, 4, 2, 3}},\n\t\"A000123\" -> {0, {1, 2, 4, 6, 10, 14, 20, 26, 36, \
46, 60, 74, 94, 114, 140, 166, 202, 238, 284, 330, 390, 450, 524, 598, 692, \
786, 900, 1014, 1154, 1294, 1460, 1626, 1828, 2030, 2268, 2506, 2790, 3074, \
3404, 3734, 4124, 4514}},\n\t\"A018252\" -> {1, {1, 4, 6, 8, 9, 10, 12, 14, \
15, 16, 18, 20, 21, 22, 24, 25, 26, 27, 28, 30, 32, 33, 34, 35, 36, 38, 39, \
40, 42, 44, 45, 46, 48, 49, 50, 51, 52, 54, 55, 56, 57, 58}},\n\t\"A000272\" \
-> {0, {1, 1, 1, 3, 16, 125, 1296, 16807, 262144, 4782969, 100000000, \
2357947691, 61917364224, 1792160394037, 56693912375296, 1946195068359375, \
72057594037927936, 2862423051509815793, 121439531096594251776, \
