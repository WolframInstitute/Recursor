3, 4, 2, 6, 2, 4, 4, 5, 2, 6, 2, 6, 4, 4, 2, 8, 3, 4, 4, 6, 2, 8, 2, 6, 4, 4, \
4, 9, 2, 4, 4, 8, 2, 8}},\n\t\"A002808\" -> {1, {4, 6, 8, 9, 10, 12, 14, 15, \
16, 18, 20, 21, 22, 24, 25, 26, 27, 28, 30, 32, 33, 34, 35, 36, 38, 39, 40, \
