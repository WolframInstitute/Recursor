Notebook[{Cell[CellGroupData[{Cell["Synthesizing sequence programs", 
      "Title"], Cell["A working notebook for SynthesizeRecursor and \
TranslateRecursor. Evaluate the Setup section first; every other section can \
then be run and changed on its own.", "Text"]}, Open]], 
  Cell[CellGroupData[{Cell["Setup", "Section"], 
     Cell["Load the paclet from this checkout.", "Text"], 
     Cell["PacletDirectoryLoad[FileNameJoin[{ParentDirectory[NotebookDirector\
y[]], \"Recursor\"}]];\n\nNeeds[\"WolframInstitute`Recursor`\"]", "Code"], 
     Cell["The recorded terms of an OEIS sequence, as {index, value} pairs, \
from the local corpus file.", "Text"], Cell["corpus = \
FileNameJoin[{ParentDirectory[NotebookDirectory[]], \"build\", \
\"oeis-corpus-v2\", \"data\", \"sequences.tsv\"}];\n\noeis[id_String] := \
With[{line = ReadList[\"!grep -m1 '^\" <> id <> \"[[:space:]]' '\" <> corpus \
<> \"'\", String]},\n\tIf[line === {}, Missing[\"NotInCorpus\", \
id],\n\t\tWith[{fields = StringSplit[First[line], \
\"\\t\"]},\n\t\t\tWith[{terms = FromDigits /@ StringSplit[fields[[3]], \
\",\"]},\n\t\t\t\tTranspose[{FromDigits[fields[[2]]] + Range[0, Length[terms] \
- 1], terms}]\n\t\t\t]\n\t\t]\n\t]\n]", "Code"], Cell["One experiment: \
synthesize from the first terms and check the program on the terms after \
them.", "Text"], Cell["study[examples_List, given_Integer, options___] := \
Module[{shown, later, seconds, result},\n\t{shown, later} = \
TakeDrop[examples, UpTo[given]];\n\tlater = Take[later, \
UpTo[40]];\n\t{seconds, result} = AbsoluteTiming[SynthesizeRecursor[shown, \
options]];\n\tJoin[result, <|\n\t\t\"Seconds\" -> N[Round[seconds, \
1/10]],\n\t\t\"LaterChecked\" -> Length[later],\n\t\t\"LaterMatched\" -> \
If[MissingQ[result[\"Program\"]], 0,\n\t\t\tLengthWhile[later, \
EvaluateRecursor[result[\"Program\"], First[#], \"MaxSteps\" -> 5000000, \
\"TimeLimit\" -> 20] === Last[#] &]]\n\t|>]\n]\n\nsummary[result_Association] \
:= KeyTake[result, {\"Solved\", \"Method\", \"Nodes\", \"Evidence\", \
\"HeldOutMatches\", \"HeldOutExamples\", \"LaterMatched\", \"LaterChecked\", \
\"Seconds\"}]", "Code"], Cell["Recorded terms against the values of the \
program. The lines end the terms the search saw and the terms it was tested \
on.", "Text"], Cell["predictionPlot[examples_List, result_Association, \
count_Integer : 40] := Module[{shown = Take[examples, UpTo[count]], values, \
ends},\n\tvalues = {First[#], EvaluateRecursor[result[\"Program\"], First[#], \
\"MaxSteps\" -> 5000000, \"TimeLimit\" -> 20]} & /@ shown;\n\tends = \
examples[[{result[\"TrainingExamples\"], result[\"TrainingExamples\"] + \
result[\"HeldOutExamples\"]}, 1]] + 1/2;\n\tIf[Min[shown[[All, 2]]] > 0 && \
Max[shown[[All, 2]]] > 200 Median[shown[[All, 2]]], ListLogPlot, \
ListPlot][\n\t\t{shown, Select[values, IntegerQ[Last[#]] &]},\n\t\tJoined -> \
{True, False}, PlotMarkers -> {{\"\\[FilledCircle]\", 7}, \
{\"\\[EmptySquare]\", 13}}, PlotLegends -> {\"Recorded\", \
\"Program\"},\n\t\tFrame -> True, FrameLabel -> {\"Index\", \"Value\"}, \
GridLines -> {ends, None}, PlotRange -> All]\n]", "Code"]}, Open]], 
