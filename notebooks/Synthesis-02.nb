Cell[BoxData[
 RowBox[{
  RowBox[{"predictionPlot", "[", 
   RowBox[{"examples_List", ",", "result_Association", ",", 
    RowBox[{"count_Integer", ":", "40"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"shown", "=", 
       RowBox[{"Take", "[", 
        RowBox[{"examples", ",", 
         RowBox[{"UpTo", "[", "count", "]"}]}], "]"}]}], ",", "values", ",", 
      "ends"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"values", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "[", "#", "]"}], ",", 
          RowBox[{"EvaluateRecursor", "[", 
           RowBox[{
            RowBox[{"result", "[", "\"\<Program\>\"", "]"}], ",", 
            RowBox[{"First", "[", "#", "]"}], ",", 
            RowBox[{"\"\<MaxSteps\>\"", "->", "5000000"}], ",", 
            RowBox[{"\"\<TimeLimit\>\"", "->", "20"}]}], "]"}]}], "}"}], 
        "&"}], "/@", "shown"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ends", "=", 
      RowBox[{
       RowBox[{"examples", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"result", "[", "\"\<TrainingExamples\>\"", "]"}], ",", 
            RowBox[{
             RowBox[{"result", "[", "\"\<TrainingExamples\>\"", "]"}], "+", 
             RowBox[{"result", "[", "\"\<HeldOutExamples\>\"", "]"}]}]}], 
           "}"}], ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"1", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"shown", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"values", ",", 
           RowBox[{
            RowBox[{"IntegerQ", "[", 
             RowBox[{"Last", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Joined", "->", 
        RowBox[{"{", 
         RowBox[{"True", ",", "False"}], "}"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
