       "\[IndentingNewLine]", 
       RowBox[{"GridLines", "->", 
        RowBox[{"{", 
         RowBox[{"ends", ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", "]"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
