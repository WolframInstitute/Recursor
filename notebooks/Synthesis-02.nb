Cell[BoxData[
 RowBox[{
  RowBox[{"oeis", "[", "id_String", "]"}], ":=", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"line", "=", 
      RowBox[{"ReadList", "[", 
       RowBox[{
        RowBox[{"\"\<!grep -m1 '^\>\"", "<>", "id", 
         "<>", "\"\<[[:space:]]' '\>\"", "<>", "corpus", "<>", "\"\<'\>\""}], 
        ",", "String"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"fields", "=", 
      RowBox[{"StringSplit", "[", 
       RowBox[{
        RowBox[{"First", "[", "line", "]"}], ",", "\"\<\\t\>\""}], "]"}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"terms", "=", 
      RowBox[{"FromDigits", "/@", 
       RowBox[{"StringSplit", "[", 
        RowBox[{
         RowBox[{"fields", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", "\"\<,\>\""}], "]"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{"fields", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "+", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"Length", "[", "terms", "]"}], "-", "1"}]}], "]"}]}], ",", 
       "terms"}], "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
