Cell[BoxData[
 RowBox[{
  RowBox[{"study", "[", 
   RowBox[{"examples_List", ",", "given_Integer", ",", "options___"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"shown", ",", "later", ",", "seconds", ",", "result"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shown", ",", "later"}], "}"}], "=", 
      RowBox[{"TakeDrop", "[", 
       RowBox[{"examples", ",", 
        RowBox[{"UpTo", "[", "given", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"later", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"later", ",", 
        RowBox[{"UpTo", "[", "40", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"seconds", ",", "result"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"SynthesizeRecursor", "[", 
        RowBox[{"shown", ",", "options"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"result", ",", 
       RowBox[{"<|", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<Seconds\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"Round", "[", 
            RowBox[{"seconds", ",", 
             RowBox[{"1", "/", "10"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<LaterChecked\>\"", "->", 
          RowBox[{"Length", "[", "later", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<LaterMatched\>\"", "->", 
          RowBox[{"If", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"MissingQ", "[", 
             RowBox[{"result", "[", "\"\<Program\>\"", "]"}], "]"}], ",", "0",
             ",", 
            RowBox[{"LengthWhile", "[", 
             RowBox[{"later", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"EvaluateRecursor", "[", 
                 RowBox[{
                  RowBox[{"result", "[", "\"\<Program\>\"", "]"}], ",", 
                  RowBox[{"First", "[", "#", "]"}], ",", 
                  RowBox[{"\"\<MaxSteps\>\"", "->", "5000000"}], ",", 
                  RowBox[{"\"\<TimeLimit\>\"", "->", "20"}]}], "]"}], "===", 
                RowBox[{"Last", "[", "#", "]"}]}], "\[IndentingNewLine]", 
               "&"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
        "\[IndentingNewLine]", "|>"}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{4.003489978906617*^9, 4.003490105087758*^9}, {
