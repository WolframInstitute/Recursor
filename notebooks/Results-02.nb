         "\n", RowBox[{RowBox[{RowBox[{"program", "[", "id_", "]"}], ":=", 
             RowBox[{RowBox[{"records", "[", "id", "]"}], "[", "\"Program\"", 
               "]"}]}], ";"}], "\n", RowBox[
          {RowBox[{RowBox[{"share", "[", "count_", "]"}], ":=", 
             RowBox[{"N", "[", FractionBox[RowBox[{"100", " ", "count"}], 
