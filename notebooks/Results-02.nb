         "\n", RowBox[{RowBox[{RowBox[{"cumulative", "[", RowBox[
                {"protocol_", ",", "key_"}], "]"}], ":=", 
             RowBox[{"Accumulate", "[", RowBox[{"Lookup", "[", RowBox[
                  {RowBox[{"protocol", "[", "\"Rounds\"", "]"}], ",", 
                   "key"}], "]"}], "]"}]}], ";"}], "\n", 
         RowBox[{RowBox[{RowBox[{"passing", "[", "protocol_", "]"}], ":=", 
             RowBox[{"Association", "[", RowBox[{RowBox[{"(", RowBox[
