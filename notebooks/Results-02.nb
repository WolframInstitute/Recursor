                     "&"}], ")"}], "/@", RowBox[{"protocol", "[", 
                   "\"Methods\"", "]"}]}], "]"}]}], ";"}], "\n", 
         RowBox[{RowBox[{RowBox[{"computed", "[", RowBox[{"id_", ",", 
                 "amount_"}], "]"}], ":=", RowBox[{RowBox[{"Table", "[", 
                 RowBox[{RowBox[{"EvaluateRecursor", "[", RowBox[
                      {RowBox[{"program", "[", "id", "]"}], ",", "n", ",", 
