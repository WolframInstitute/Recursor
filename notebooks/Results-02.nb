    RowBox[{"EvaluateRecursor", "[", 
     RowBox[{
      RowBox[{"program", "[", "\"\<A000040\>\"", "]"}], ",", "n"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "60", ",", "72"}], "}"}]}], "]"}], "===", 
  RowBox[{"Prime", "[", 
   RowBox[{"Range", "[", 
    RowBox[{"60", ",", "72"}], "]"}], "]"}]}]], "Input",ExpressionUUID->\
"749ec1c4-a461-40a7-9f80-d28f47afde5d"],

Cell[BoxData["False"], "Output",ExpressionUUID->"b8ab2ff3-4d8b-4435-afdb-7e7c2b08367a"]
}, Open  ]],

Cell["\<\
The eight-term program rests on Wilson's theorem and stays exact.\
\>", "Text",ExpressionUUID->"f62a76f0-98f9-4f0f-be04-28ab9859664f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"trial", "=", 
  RowBox[{"Last", "[", 
   RowBox[{"program", "[", "\"\<A001223\>\"", "]"}], "]"}]}]], "Input",Express\
ionUUID->"18c2d966-a022-4f43-b178-5997a43ad55f"],

Cell[BoxData[
 RowBox[{"Pred", "[", 
  RowBox[{"Iter", "[", 
   RowBox[{
    RowBox[{"Succ", "[", "Var", "]"}], ",", 
    RowBox[{"Const", "[", "0", "]"}], ",", 
    RowBox[{"Succ", "[", 
     RowBox[{"WhileLoop", "[", 
      RowBox[{"Acc", ",", 
       RowBox[{"Let", "[", 
        RowBox[{
         RowBox[{"Let", "[", 
          RowBox[{"Acc", ",", 
           RowBox[{"Rec", "[", 
            RowBox[{"Var", ",", "Var", ",", 
             RowBox[{"Ifz", "[", 
              RowBox[{
               RowBox[{"Rem", "[", 
                RowBox[{"Var", ",", "Idx"}], "]"}], ",", "Idx", ",", "Acc"}], 
              "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"Add", "[", 
          RowBox[{
           RowBox[{"Monus", "[", 
            RowBox[{"Var", ",", 
             RowBox[{"Const", "[", "1", "]"}]}], "]"}], ",", 
           RowBox[{"Monus", "[", 
            RowBox[{
             RowBox[{"Const", "[", "1", "]"}], ",", "Var"}], "]"}]}], "]"}]}],
         "]"}], ",", 
       RowBox[{"Succ", "[", "Acc", "]"}]}], "]"}], "]"}]}], "]"}], 
  "]"}]], "Output",ExpressionUUID->"57d4cb54-4e65-42e9-805e-73cf75537be4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
