Cell[TextData[{
 StyleBox["179 of 109,320 primary-test evaluations hit the step budget.",
  FontWeight->Bold],
 " \nTen candidate programs fail this test solely through unfinished \
evaluations, without an observed wrong value; \nbudget exhaustion does not \
prove non-termination."
}], "Text",
 CellChangeTimes->{{4.002952531388587*^9, 
  4.002952566837425*^9}},ExpressionUUID->"ba6d47ef-9c1c-4fa3-80f7-\
3ee60e21c123"],

Cell["\<\
Figure 35. How often programs trained on constant or changing terms also \
match later terms.\
\>", "Text",
 CellChangeTimes->{
  4.002952372509416*^9},ExpressionUUID->"0dcf6703-bfe4-499f-b56f-\
766e8478a26b"],

