  Cell[CellGroupData[{Cell["Evolution and synthesis on your own sequence", 
      "Section"], 
     Cell[
      "The first eight terms go to each search; the rest test the programs.", 
      "Text"], Cell["compare[sequence_List] := With[{examples = \
Transpose[{Range[0, 7], Take[sequence, 8]}], later = Transpose[{Range[8, \
Length[sequence] - 1], Drop[sequence, 8]}]},\n\tMap[\n\t\t<|\"Program\" -> \
FormatRecursor[#], \"Nodes\" -> RecursorNodeCount[#],\n\t\t\t\"Terms fitted\" \
-> Count[examples, {n_, value_} /; EvaluateRecursor[#, n] === \
value],\n\t\t\t\"Later terms right\" -> Row[{Count[later, {n_, value_} /; \
EvaluateRecursor[#, n, \"MaxSteps\" -> 1000000] === value], \" of \", \
Length[later]}]|> &,\n\t\t<|\"Improved evolution\" -> \
improvedEvolve[examples, options, 9101][\"Program\"], \"Guided evolution\" -> \
guidedSearch[examples][\"Program\"],\n\t\t\t\"Synthesis\" -> \
Replace[SynthesizeRecursor[examples][\"Program\"], _Missing -> \
Const[0]]|>\n\t]\n]", "Code"], Cell[CellGroupData[
